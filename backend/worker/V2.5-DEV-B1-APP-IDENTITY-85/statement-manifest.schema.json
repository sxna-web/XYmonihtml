{
 "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object",
 "required":["manifest_version","interface","status","policy","statements"],
 "properties":{
  "manifest_version":{"const":"1.1"},
  "interface":{"enum":["identity_adapter","limiter_adapter","disposable_harness"]},
  "status":{"const":"DESIGN_ONLY_NO_SQL"},
  "policy":{"type":"object","required":["production_sql_permitted"],"properties":{"production_sql_permitted":{"const":false}}},
  "statements":{"type":"array","items":{"$ref":"#/$defs/statement"}}
 },"additionalProperties":false,
 "$defs":{"statement":{
  "type":"object",
  "required":["statement_id","owner","method","purpose","result_contract","error_contract","receipt_dependencies","audit_dependencies","assertion_dependencies","sql_state","sql_sha256","placeholders","binds"],
  "properties":{
   "statement_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{2,95}$"},
   "owner":{"type":"string","minLength":1},"method":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},
   "result_contract":{"type":"object"},"error_contract":{"type":"object"},
   "receipt_dependencies":{"type":"array","items":{"type":"string"}},
   "audit_dependencies":{"type":"array","items":{"type":"string"}},
   "assertion_dependencies":{"type":"array","items":{"type":"string"}},
   "sql_state":{"const":"NOT_FROZEN"},"sql_sha256":{"type":"null"},
   "placeholders":{"type":"array","maxItems":0},"binds":{"type":"array","maxItems":0}
  },"additionalProperties":false
 }}
}